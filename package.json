{
  "name": "heartara-webapp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "test": "node --test booking-rules.test.js tests/*.test.mjs",
    "crm:build": "esbuild crm/src/client.js --bundle --minify --format=iife --target=es2022 --outfile=crm/public/app.js",
    "crm:start": "node --env-file-if-exists=crm/.env crm/server.js",
    "crm:worker": "node --env-file-if-exists=crm/.env crm/worker.js",
    "crm:test": "node --test crm/tests/*.test.js",
    "crm:test:integration": "bash crm/scripts/test.sh",
    "crm:test:browser": "node crm/tests/browser.cjs && node crm/tests/contact-workflow.cjs",
    "vercel:build": "npm run crm:build && node crm/scripts/build-vercel.js",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "dev": "node server.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/functions": "^3.10.3",
    "svix": "^2.9.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "pg": "^8.23.1",
    "playwright": "^1.64.1"
  }
}
