# Server-only secrets. Copy to a secret manager, never into public-config.js or Git.
NODE_ENV=production
SITE_ENV=production
PUBLIC_BASE_URL=https://heartara.github.io/webapp/
CRM_DB_PATH=/var/lib/heartara/crm.sqlite
CRM_ENCRYPTION_KEY=
ADMIN_TOKEN=
RESEND_API_KEY=
MAIL_FROM=
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=
ALLOWED_ORIGINS=https://heartara.github.io
# Enable only behind a trusted proxy that replaces X-Forwarded-For.
TRUST_PROXY=0
